# =============================================================================
# Smart Café Vision — environment configuration
# Copy to `.env` and edit. NEVER commit `.env`.
# =============================================================================

# ---- Deployment identity ----------------------------------------------------
COMPOSE_PROJECT_NAME=smartcafe
ENVIRONMENT=development            # development | staging | production

# ---- Django -----------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-insecure-development-key-do-not-use-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=console          # console | json  (use json in production)

# Fernet key used to encrypt RTSP passwords at rest (§25).
# Generate with: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=

# Raw video is never persisted unless explicitly turned on here (§26). Off by
# default, and turning it on changes the legal picture for the venue
# substantially -- that is the venue's decision to make and to document, not
# a setting to flip without thinking about it. See docs/privacy.md.
ALLOW_VIDEO_RECORDING=false

# ---- Error tracking (§16, §28) -----------------------------------------------
# Strictly opt-in and off by default -- a café is local-first and must keep
# working with no internet at all. Leave blank unless this venue has internet
# access and wants crash visibility; production.py never imports sentry_sdk
# when this is unset. Local variables are never sent (see production.py) --
# this product's whole premise is anonymous tracking, and a stack frame can
# hold an RTSP URL or a raw request body.
SENTRY_DSN=
# Fraction of requests to trace (0.0-1.0). Errors are always reported
# regardless of this setting; this only controls performance tracing.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- URLs / CORS / CSRF -----------------------------------------------------
# Public origin of the Next.js app. On a café LAN this is the server's IP.
FRONTEND_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Set only once a reverse proxy terminates TLS in front of this install
# (deployment/nginx/ or your own). Turns on SECURE_SSL_REDIRECT, HSTS, and
# secure cookies together -- leave unset on a plain-HTTP LAN install, where
# setting it would make the browser silently drop the session cookie.
BEHIND_TLS_PROXY=false

# ---- Database ---------------------------------------------------------------
POSTGRES_DB=smartcafe
POSTGRES_USER=smartcafe
POSTGRES_PASSWORD=smartcafe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional single-URL override (takes precedence over the parts above).
# Supports postgres:// and sqlite:// (sqlite is for lightweight dev only).
DATABASE_URL=

# ---- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Redis Streams key used as the AI worker -> backend event bus.
EVENT_STREAM_KEY=scv:events
EVENT_STREAM_GROUP=scv-ingest
EVENT_STREAM_MAXLEN=100000

# Cache backend: "redis" (required in production) or "locmem" for a development
# machine with no Redis running. locmem makes login throttling per-process.
CACHE_BACKEND=redis

# ---- Customer sessions (§5) --------------------------------------------------
# How long a session may go without evidence of the person still being in
# frame (a crossing, or a camera_stats heartbeat) before it is closed as
# TRACK_LOST -- covers both a lost tracker and an AI worker restart. Several
# multiples of CAMERA_STATS_INTERVAL_SECONDS below, so a couple of missed
# heartbeats never closes a session that is still genuinely open.
SESSION_STALE_GRACE_SECONDS=120
# How often the Celery beat task checks for and closes stale sessions.
SESSION_STALE_CHECK_INTERVAL_SECONDS=60

# ---- Analytics (§8) -----------------------------------------------------------
# How often the Celery beat task recomputes today's (and, if not yet final,
# yesterday's) DailyStat rollup row per café.
ANALYTICS_ROLLUP_INTERVAL_SECONDS=900

# ---- Table sessions (§10) ------------------------------------------------------
# Same shape as SESSION_STALE_GRACE_SECONDS above, applied to table occupancy:
# how long a TableSession may go without an occupied_table_ids heartbeat
# before it is closed as STALE.
TABLE_STALE_GRACE_SECONDS=120
# How often the Celery beat task checks for and closes stale table sessions.
TABLE_STALE_CHECK_INTERVAL_SECONDS=60

# ---- Event log retention (Phase 10, §16) -------------------------------------
# How long a raw TrackingEvent row survives before it is pruned. Safe to
# shorten: every durable figure the product reports (sessions, table
# sessions, daily rollups) is computed and stored at ingest time, not read
# from raw events later -- pruning only gives up the ability to recompute a
# projection for that day if a bug is ever found in one. 0 disables pruning.
EVENT_RETENTION_DAYS=90
# How often the Celery beat task checks for and deletes events past retention.
EVENT_PRUNE_INTERVAL_SECONDS=86400

# ---- Auth -------------------------------------------------------------------
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- AI worker --------------------------------------------------------------
# auto -> use CUDA when available, otherwise CPU. Or force: cuda | cpu -- an
# explicit cuda request that finds no GPU fails loudly rather than silently
# running on CPU (see docs/gpu-setup.md).
AI_DEVICE=auto
AI_MODEL=yolo11n.pt
AI_TARGET_FPS=10                   # inference FPS cap per camera (not camera FPS)
AI_WORKER_ID=worker-1
# Service token the worker uses to authenticate to the backend REST API.
AI_WORKER_TOKEN=change-me-worker-token

# Container resource ceiling (docker-compose.ai.yml), not a worker setting --
# raise for a larger install (docs/hardware.md), e.g. 8.0 / 8g for 4 cameras
# on CPU, more for a GPU box running several. Docker OOM-kills and restarts
# (restart: unless-stopped) the container if this is set too low for the
# camera count actually configured.
AI_WORKER_CPU_LIMIT=4.0
AI_WORKER_MEMORY_LIMIT=4g

# A model that fails to load (no internet on first run, an unsupported CPU,
# out of memory) degrades to capture-only mode automatically -- it never takes
# camera capture and the live preview down with it.
AI_DETECTION_ENABLED=true
# Detections below this confidence are discarded. Lower catches more people at
# the cost of more false positives (a coat rack, a poster); 0.5 is a
# reasonable starting point for a café.
AI_CONFIDENCE_THRESHOLD=0.5

# ---- Frontend (build + runtime) ---------------------------------------------
# Server-side (inside Docker network) base URL used by the Next.js BFF layer.
BACKEND_INTERNAL_URL=http://backend:8000
# Browser-visible WebSocket origin. On a LAN, use ws://<server-ip>:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
