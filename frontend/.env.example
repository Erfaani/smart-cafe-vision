# Frontend-only overrides. The Docker stack injects these from the root .env.

# Server-side base URL for the Django API (never exposed to the browser).
BACKEND_INTERNAL_URL=http://localhost:8000

# Browser-visible WebSocket origin. On a café LAN use ws://<server-ip>:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Set to "true" only when a TLS-terminating proxy is in front, so session
# cookies are marked `secure`. On a plain-HTTP LAN install this must stay unset
# or the browser will silently drop the cookie and login will appear to do
# nothing.
BEHIND_TLS_PROXY=
